{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question_bank.schema.json",
  "title": "题库",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "stem", "analysis", "chapterId", "difficulty", "pointIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^q-[a-z0-9-]+$" },
          "type": {
            "enum": ["single", "fill"],
            "description": "single 单选题 / fill 填空题"
          },
          "stem": { "type": "string", "minLength": 1, "description": "题干" },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1 },
            "description": "四个选项，按 A/B/C/D 顺序（仅 single）"
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "正确选项下标（0=A，仅 single）"
          },
          "accept": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "填空题可接受答案列表（仅 fill）；判分前做归一化：去空白/小写/上标转^/全角括号转半角"
          },
          "analysis": { "type": "string", "minLength": 1, "description": "解析，提交后展示" },
          "chapterId": { "type": "string", "description": "所属章节，必须存在于 knowledge.json" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
          "pointIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "关联考点 id 列表：星球面板「开始做题」按此字段抽题；一题可关联多个考点"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "single" } }, "required": ["type"] },
            "then": { "required": ["options", "answer"] }
          },
          {
            "if": { "properties": { "type": { "const": "fill" } }, "required": ["type"] },
            "then": {
              "required": ["accept"],
              "not": { "anyOf": [{ "required": ["options"] }, { "required": ["answer"] }] }
            }
          }
        ]
      }
    }
  }
}